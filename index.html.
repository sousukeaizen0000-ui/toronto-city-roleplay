<script>

function toggleMenu() {

    const menu = document.getElementById("navLinks");

    menu.classList.toggle("open");

}

document.querySelectorAll(".nav-links a").forEach(link => {

    link.addEventListener("click", () => {

        document
            .getElementById("navLinks")
            .classList.remove("open");

    });

});

</script>

